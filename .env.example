# Manus API v2 credentials
MANUS_API_KEY=replace-with-your-manus-api-key

# Optional routing. Set exactly one or both according to your integration.
# If MANUS_TASK_ID is set, /api/chat continues that task via task.sendMessage.
# If MANUS_TASK_ID is omitted, /api/chat creates a task via task.create.
MANUS_TASK_ID=
MANUS_PROJECT_ID=

# Manus API endpoint. Keep the official default unless using a controlled proxy.
MANUS_API_BASE_URL=https://api.manus.ai
MANUS_API_TIMEOUT_SECONDS=30

# Browser CORS origins. Comma-separated URLs; never use '*' with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
